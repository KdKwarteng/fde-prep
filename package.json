    "test": "node --experimental-strip-types --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@supabase/supabase-js": "^2.119.0",
    "@uiw/react-codemirror": "^4.25.12",
    "next": "16.4.6",
    "pyodide": "^314.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
