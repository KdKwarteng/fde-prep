{
  "name": "fde-prep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify": "python3 scripts/verify_problems.py",
    "predev": "npm run prepare:content",
